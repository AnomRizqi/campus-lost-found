rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.firebase.sign_in_provider == 'password' &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Profiles Rules
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      // On creation, a user cannot set their role to 'admin' (must default to 'user')
      allow create: if isAuthenticated() && request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role == 'user');
      // A user cannot change their own role; only existing admins can update roles.
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Reports Rules
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
    }
  }
}
